# Sao chép file này thành .env và thay các mật khẩu trước khi chạy.
MYSQL_ROOT_PASSWORD=replace_with_a_unique_root_password
MYSQL_DATABASE=podcast_library
MYSQL_USER=podcast_app
MYSQL_PASSWORD=replace_with_a_unique_app_password
MYSQL_EXPORTER_PASSWORD=replace_with_a_unique_metrics_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_grafana_password
