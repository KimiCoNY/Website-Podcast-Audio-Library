{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "WordPress HTTP UP",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "probe_success{job=\"wordpress-http\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "type": "timeseries",
      "title": "Host CPU Usage (%)",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [{
        "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Host Memory Usage (%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{
        "expr": "container_memory_usage_bytes{name!=\"\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "type": "timeseries",
      "title": "MySQL Connections",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{
        "expr": "mysql_global_status_threads_connected",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "WordPress HTTP Response Time (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{
        "expr": "probe_duration_seconds{job=\"wordpress-http\"}",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Container Network Receive (bytes/s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{
        "expr": "sum by(name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["student", "prometheus", "grafana", "docker", "wordpress"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "title": "WordPress Server Monitoring Lab",
  "uid": "wp-monitoring-lab"
}
